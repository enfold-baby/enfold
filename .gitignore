/macos/Flutter/ephemeral/

# Web
/web/.dart_tool/

# Test / tooling artifacts
.test_runner/
agent-tools/
*.log

# Licensed Adobe Stock source packages are local-only. Commit only the
# transformed app illustrations exported from these originals.
/design_assets/adobe_stock/source/

# Release artifacts (build locally or in CI)
*.apk
*.aab
*.ipa
*.dSYM.zip

# Drift — generated code IS committed; only ignore temp
*.drift.dart.tmp

# Local demo / marketing capture output
screenshots/

# Sideload APK uploads (local/prod data)
backend/uploads/
.playwright-mcp/
