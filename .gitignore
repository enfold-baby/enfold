.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
*.g.dart.bak

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android
/android/.gradle/
/android/local.properties
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
