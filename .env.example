APP_ENV=development
SITE_ADDRESS=http://localhost:8280

POSTGRES_USER=bloomdue
POSTGRES_PASSWORD=bloomdue_dev_change_me
POSTGRES_DB=bloomdue
DATABASE_URL=postgresql+asyncpg://bloomdue:bloomdue_dev_change_me@postgres:5432/bloomdue
REDIS_URL=redis://redis:6379/0

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8280,http://localhost:8283,http://127.0.0.1:8280,http://127.0.0.1:8283
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=10080

MAGIC_CODE_EXPIRE_MINUTES=10
DEV_MAGIC_CODE_LOG=true

SMTP_FROM_EMAIL=noreply@enfold.baby
SMTP_FROM_NAME=Enfold
CONTACT_EMAIL=support@enfold.baby
BETA_REQUEST_TO_EMAIL=support@enfold.baby

# AWS SES — leave empty locally (codes print to logs). Required in production.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=

# FCM — set both to send partner-activity pushes. JSON may be raw, a file path, or base64.
# Drop backend/secrets/firebase-sa.json (gitignored). In Docker: /app/secrets/firebase-sa.json
FIREBASE_PROJECT_ID=enfold-28c4e
FIREBASE_SERVICE_ACCOUNT_JSON=/app/secrets/firebase-sa.json
APP_VERSION_ADMIN_TOKEN=
