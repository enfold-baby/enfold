APP_ENV=production
SITE_ADDRESS=https://enfold.baby

POSTGRES_USER=bloomdue
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=bloomdue
DATABASE_URL=postgresql+asyncpg://bloomdue:replace_me@postgres:5432/bloomdue
REDIS_URL=redis://redis:6379/0

CORS_ALLOW_ORIGINS=https://enfold.baby,https://www.enfold.baby,https://due.enfold.baby
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE_MINUTES=10080

MAGIC_CODE_EXPIRE_MINUTES=10
DEV_MAGIC_CODE_LOG=false

SMTP_FROM_EMAIL=noreply@enfold.baby
SMTP_FROM_NAME=Enfold
CONTACT_EMAIL=support@enfold.baby
BETA_REQUEST_TO_EMAIL=support@enfold.baby
DEV_MAGIC_CODE_LOG=false

SES_REGION=eu-central-1
SES_ACCESS_KEY_ID=replace_me
SES_SECRET_ACCESS_KEY=replace_me

MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=

# FCM partner push. Drop the service-account JSON at backend/secrets/firebase-sa.json
# on the VPS (mounted at /app/secrets/firebase-sa.json).
FIREBASE_PROJECT_ID=enfold-28c4e
FIREBASE_SERVICE_ACCOUNT_JSON=/app/secrets/firebase-sa.json

# Google Play reviewer account (fixed sign-in code, no email sent). Leave empty to disable.
REVIEWER_EMAIL=
REVIEWER_CODE=
